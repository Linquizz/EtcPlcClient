<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:EtcPlcClient.ViewModels"
        x:Class="EtcPlcClient.Views.MainWindow"
        Title="ETC — PLC Modbus Client"
        Width="860" Height="680"
        MinWidth="700" MinHeight="520"
        Background="#111111"
        FontFamily="Segoe UI,Arial"
        x:DataType="vm:MainWindowViewModel">

<Window.Resources>
    <ControlTheme x:Key="SwitchToggleTheme" TargetType="ToggleButton">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Padding" Value="0"/>
      <Setter Property="Width" Value="44"/>
      <Setter Property="Height" Value="24"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
      <Setter Property="Template">
        <ControlTemplate>
          <ContentPresenter Content="{TemplateBinding Content}"
                            Background="Transparent"
                            BorderThickness="0"
                            HorizontalContentAlignment="Stretch"
                            VerticalContentAlignment="Stretch"/>
        </ControlTemplate>
      </Setter>
    </ControlTheme>
  </Window.Resources>

  <Window.Styles>

    <Style Selector="TextBlock.page-title">
      <Setter Property="Foreground" Value="#f0f0f0"/>
      <Setter Property="FontSize" Value="18"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>

    <Style Selector="TextBlock.page-sub">
      <Setter Property="Foreground" Value="#555555"/>
      <Setter Property="FontSize" Value="11"/>
      <Setter Property="Margin" Value="0,3,0,0"/>
    </Style>

    <Style Selector="TextBlock.section-header">
      <Setter Property="Foreground" Value="#f0f0f0"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>

    <Style Selector="TextBlock.section-sub">
      <Setter Property="Foreground" Value="#444444"/>
      <Setter Property="FontSize" Value="10"/>
      <Setter Property="Margin" Value="0,3,0,0"/>
    </Style>

    <Style Selector="TextBlock.ch-name">
      <Setter Property="Foreground" Value="#e0e0e0"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <Style Selector="TextBlock.ch-addr">
      <Setter Property="Foreground" Value="#444444"/>
      <Setter Property="FontSize" Value="10"/>
      <Setter Property="Margin" Value="0,2,0,0"/>
    </Style>

    <Style Selector="TextBlock.ai-reading">
      <Setter Property="Foreground" Value="#00e676"/>
      <Setter Property="FontSize" Value="15"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
      <Setter Property="MinWidth" Value="86"/>
      <Setter Property="TextAlignment" Value="Right"/>
    </Style>

    <Style Selector="TextBlock.input-label">
      <Setter Property="Foreground" Value="#555555"/>
      <Setter Property="FontSize" Value="10"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Margin" Value="0,0,0,6"/>
    </Style>

    <Style Selector="Border.card">
      <Setter Property="Background" Value="#1c1c1c"/>
      <Setter Property="CornerRadius" Value="12"/>
      <Setter Property="BorderBrush" Value="#2a2a2a"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Padding" Value="20"/>
    </Style>

    <Style Selector="Border.ch-row">
      <Setter Property="Background" Value="#222222"/>
      <Setter Property="CornerRadius" Value="8"/>
      <Setter Property="BorderBrush" Value="#2e2e2e"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Padding" Value="16,0"/>
    </Style>

    <Style Selector="Border.ch-row-active">
      <Setter Property="Background" Value="#182218"/>
      <Setter Property="CornerRadius" Value="8"/>
      <Setter Property="BorderBrush" Value="#1a3d1a"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Padding" Value="16,0"/>
    </Style>

    <Style Selector="Ellipse.dot-off">
      <Setter Property="Width" Value="6"/>
      <Setter Property="Height" Value="6"/>
      <Setter Property="Fill" Value="#333333"/>
      <Setter Property="Margin" Value="0,0,12,0"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <Style Selector="Ellipse.dot-on">
      <Setter Property="Width" Value="6"/>
      <Setter Property="Height" Value="6"/>
      <Setter Property="Fill" Value="#00e676"/>
      <Setter Property="Margin" Value="0,0,12,0"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <Style Selector="Border.track-off">
      <Setter Property="Width" Value="44"/>
      <Setter Property="Height" Value="24"/>
      <Setter Property="CornerRadius" Value="12"/>
      <Setter Property="Background" Value="#333333"/>
      <Setter Property="BorderBrush" Value="#3d3d3d"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <Style Selector="Border.track-on">
      <Setter Property="Width" Value="44"/>
      <Setter Property="Height" Value="24"/>
      <Setter Property="CornerRadius" Value="12"/>
      <Setter Property="Background" Value="#007a40"/>
      <Setter Property="BorderBrush" Value="#00e676"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <Style Selector="Ellipse.thumb-off">
      <Setter Property="Width" Value="16"/>
      <Setter Property="Height" Value="16"/>
      <Setter Property="Fill" Value="#888888"/>
      <Setter Property="HorizontalAlignment" Value="Left"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
      <Setter Property="Margin" Value="3,0,0,0"/>
    </Style>

    <Style Selector="Ellipse.thumb-on">
      <Setter Property="Width" Value="16"/>
      <Setter Property="Height" Value="16"/>
      <Setter Property="Fill" Value="#00e676"/>
      <Setter Property="HorizontalAlignment" Value="Right"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
      <Setter Property="Margin" Value="0,0,3,0"/>
    </Style>

    <Style Selector="TextBox.field">
      <Setter Property="Background" Value="#1c1c1c"/>
      <Setter Property="Foreground" Value="#e0e0e0"/>
      <Setter Property="BorderBrush" Value="#2e2e2e"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="7"/>
      <Setter Property="Height" Value="36"/>
      <Setter Property="Padding" Value="10,0"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
      <Setter Property="CaretBrush" Value="#00e676"/>
      <Setter Property="SelectionBrush" Value="#00e67640"/>
    </Style>

    <Style Selector="TextBox.field /template/ Border#PART_BorderElement">
      <Setter Property="Background" Value="#1c1c1c"/>
      <Setter Property="BorderBrush" Value="#2e2e2e"/>
    </Style>

    <Style Selector="TextBox.field:pointerover /template/ Border#PART_BorderElement">
      <Setter Property="Background" Value="#222222"/>
      <Setter Property="BorderBrush" Value="#3a3a3a"/>
    </Style>

    <Style Selector="TextBox.field:focus /template/ Border#PART_BorderElement">
      <Setter Property="Background" Value="#1c1c1c"/>
      <Setter Property="BorderBrush" Value="#00e676"/>
    </Style>

    <Style Selector="TextBox.field:disabled /template/ Border#PART_BorderElement">
      <Setter Property="Background" Value="#161616"/>
      <Setter Property="BorderBrush" Value="#222222"/>
      <Setter Property="Opacity" Value="0.6"/>
    </Style>

    <Style Selector="Button.btn-connect">
      <Setter Property="Background" Value="#00c853"/>
      <Setter Property="Foreground" Value="#000000"/>
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Height" Value="36"/>
      <Setter Property="Width" Value="120"/>
      <Setter Property="CornerRadius" Value="7"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="HorizontalContentAlignment" Value="Center"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>

    <Style Selector="Button.btn-connect:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="#00e676"/>
    </Style>

    <Style Selector="Button.btn-connect:pressed /template/ ContentPresenter">
      <Setter Property="Background" Value="#009940"/>
    </Style>

    <Style Selector="Button.btn-connect:disabled /template/ ContentPresenter">
      <Setter Property="Background" Value="#1a3a1a"/>
      <Setter Property="Opacity" Value="0.5"/>
    </Style>

    <Style Selector="Button.btn-disconnect">
      <Setter Property="Background" Value="#2a2a2a"/>
      <Setter Property="Foreground" Value="#ff5252"/>
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Height" Value="36"/>
      <Setter Property="Width" Value="120"/>
      <Setter Property="CornerRadius" Value="7"/>
      <Setter Property="BorderBrush" Value="#3a3a3a"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="HorizontalContentAlignment" Value="Center"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>

    <Style Selector="Button.btn-disconnect:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="#3a1515"/>
    </Style>

    <Style Selector="Button.btn-disconnect:pressed /template/ ContentPresenter">
      <Setter Property="Background" Value="#4a0000"/>
    </Style>

    <Style Selector="Button.btn-disconnect:disabled /template/ ContentPresenter">
      <Setter Property="Opacity" Value="0.3"/>
    </Style>

    <Style Selector="Border.badge-disconnected">
      <Setter Property="Background" Value="#1f1010"/>
      <Setter Property="BorderBrush" Value="#3a1515"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="6"/>
      <Setter Property="Padding" Value="10,5"/>
    </Style>

    <Style Selector="Border.badge-connected">
      <Setter Property="Background" Value="#0d1f0d"/>
      <Setter Property="BorderBrush" Value="#1a3a1a"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="6"/>
      <Setter Property="Padding" Value="10,5"/>
    </Style>

    <Style Selector="Border.ai-tag">
      <Setter Property="Background" Value="#0d1f0d"/>
      <Setter Property="BorderBrush" Value="#1a3a1a"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="4"/>
      <Setter Property="Padding" Value="6,2"/>
      <Setter Property="Margin" Value="0,0,12,0"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <Style Selector="Border.error-panel">
      <Setter Property="Background" Value="#1f0d0d"/>
      <Setter Property="BorderBrush" Value="#3a1515"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="8"/>
      <Setter Property="Padding" Value="16,10"/>
      <Setter Property="Margin" Value="0,0,0,12"/>
    </Style>

  </Window.Styles>

  <Grid RowDefinitions="Auto,Auto,Auto,*" Margin="20,18,20,20">

    <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,0,0,14">
      <StackPanel Grid.Column="0" VerticalAlignment="Center">
        <TextBlock Classes="page-title" Text="ETC — PLC Modbus Client"/>
        <TextBlock Classes="page-sub"
                   Text="Управление цифровыми выходами и мониторинг аналоговых входов"/>
      </StackPanel>
      <Border Grid.Column="1" Name="StatusBadge"
              Classes="badge-disconnected" VerticalAlignment="Center">
        <StackPanel Orientation="Horizontal" Spacing="7">
          <Ellipse Name="StatusDot" Width="7" Height="7"
                   Fill="#ff3d3d" VerticalAlignment="Center"/>
          <TextBlock Name="StatusText"
                     Text="{Binding StatusText}"
                     Foreground="#ff5252"
                     FontSize="11" FontWeight="SemiBold"
                     VerticalAlignment="Center"/>
        </StackPanel>
      </Border>
    </Grid>

    <Border Grid.Row="1" Classes="card" Margin="0,0,0,14">
      <Grid ColumnDefinitions="*,14,90,14,70,20,*,120,10,120">

        <StackPanel Grid.Column="0">
          <TextBlock Classes="input-label" Text="IP АДРЕС"/>
          <TextBox Name="IpInput" Classes="field"
                   Text="{Binding IpAddress}"
                   PlaceholderText="Например: 127.0.0.1"
                   IsEnabled="{Binding IsDisconnected}"/>
        </StackPanel>

        <StackPanel Grid.Column="2">
          <TextBlock Classes="input-label" Text="ПОРТ"/>
          <TextBox Name="PortInput" Classes="field"
                   Text="{Binding Port}"
                   PlaceholderText="502"
                   IsEnabled="{Binding IsDisconnected}"/>
        </StackPanel>

        <StackPanel Grid.Column="4">
          <TextBlock Classes="input-label" Text="UNIT ID"/>
          <TextBox Name="UnitIdInput" Classes="field"
                   Text="{Binding UnitId}"
                   PlaceholderText="1"
                   IsEnabled="{Binding IsDisconnected}"/>
        </StackPanel>

        <Button Grid.Column="7"
                Classes="btn-connect"
                Content="Подключиться"
                IsEnabled="{Binding CanConnect}"
                VerticalAlignment="Bottom"
                Click="ConnectButton_Click"/>

        <Button Grid.Column="9"
                Classes="btn-disconnect"
                Content="Отключить"
                IsEnabled="{Binding IsConnected}"
                VerticalAlignment="Bottom"
                Click="DisconnectButton_Click"/>
      </Grid>
    </Border>

    <Border Grid.Row="2" Classes="error-panel" IsVisible="{Binding HasError}">
      <Grid ColumnDefinitions="Auto,*,Auto">
        <TextBlock Grid.Column="0" Text="⚠" Foreground="#ff5252"
                   FontSize="14" VerticalAlignment="Center" Margin="0,0,10,0"/>
        <TextBlock Grid.Column="1" Text="{Binding ErrorMessage}"
                   Foreground="#ff7070" FontSize="12" TextWrapping="Wrap"/>
        <Button Grid.Column="2" Content="✕"
                Background="Transparent" Foreground="#ff5252"
                BorderThickness="0" Cursor="Hand"
                Click="DismissError_Click" VerticalAlignment="Center"/>
      </Grid>
    </Border>

    <Grid Grid.Row="3" ColumnDefinitions="*,14,*">

      <Border Grid.Column="0" Classes="card">
        <Grid RowDefinitions="Auto,14,*">

          <Grid Grid.Row="0" ColumnDefinitions="*,Auto">
            <StackPanel Grid.Column="0">
              <TextBlock Classes="section-header" Text="Цифровые выходы"/>
              <TextBlock Classes="section-sub" Text="Coils 0 – 3"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal"
                        Spacing="5" VerticalAlignment="Top">
              <TextBlock Name="DoActiveCount" Text="0"
                         Foreground="#00e676" FontSize="12"
                         FontWeight="SemiBold" VerticalAlignment="Center"/>
              <TextBlock Text="/ 4 активно" Foreground="#444444"
                         FontSize="11" VerticalAlignment="Center"/>
            </StackPanel>
          </Grid>

          <Rectangle Grid.Row="1" Height="1" Fill="#2a2a2a"/>

          <UniformGrid Grid.Row="2" Rows="4" Columns="1">

            <Border Name="Do1Row" Classes="ch-row" Margin="0,0,0,6">
              <Grid ColumnDefinitions="Auto,*,Auto">
                <Ellipse Grid.Column="0" Name="Do1Dot" Classes="dot-off"/>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                  <TextBlock Classes="ch-name" Text="DO 1"/>
                  <TextBlock Classes="ch-addr" Text="Coil 0"/>
                </StackPanel>
                <ToggleButton Grid.Column="2"
                              Name="Do1Button"
                              Theme="{StaticResource SwitchToggleTheme}"
                              IsEnabled="{Binding IsConnected}"
                              VerticalAlignment="Center"
                              Click="Do1Button_Click">
                  <Border Name="Do1Track" Classes="track-off">
                    <Ellipse Name="Do1Thumb" Classes="thumb-off"/>
                  </Border>
                </ToggleButton>
              </Grid>
            </Border>

            <Border Name="Do2Row" Classes="ch-row" Margin="0,0,0,6">
              <Grid ColumnDefinitions="Auto,*,Auto">
                <Ellipse Grid.Column="0" Name="Do2Dot" Classes="dot-off"/>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                  <TextBlock Classes="ch-name" Text="DO 2"/>
                  <TextBlock Classes="ch-addr" Text="Coil 1"/>
                </StackPanel>
                <ToggleButton Grid.Column="2"
                              Name="Do2Button"
                              Theme="{StaticResource SwitchToggleTheme}"
                              IsEnabled="{Binding IsConnected}"
                              VerticalAlignment="Center"
                              Click="Do2Button_Click">
                  <Border Name="Do2Track" Classes="track-off">
                    <Ellipse Name="Do2Thumb" Classes="thumb-off"/>
                  </Border>
                </ToggleButton>
              </Grid>
            </Border>

            <Border Name="Do3Row" Classes="ch-row" Margin="0,0,0,6">
              <Grid ColumnDefinitions="Auto,*,Auto">
                <Ellipse Grid.Column="0" Name="Do3Dot" Classes="dot-off"/>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                  <TextBlock Classes="ch-name" Text="DO 3"/>
                  <TextBlock Classes="ch-addr" Text="Coil 2"/>
                </StackPanel>
                <ToggleButton Grid.Column="2"
                              Name="Do3Button"
                              Theme="{StaticResource SwitchToggleTheme}"
                              IsEnabled="{Binding IsConnected}"
                              VerticalAlignment="Center"
                              Click="Do3Button_Click">
                  <Border Name="Do3Track" Classes="track-off">
                    <Ellipse Name="Do3Thumb" Classes="thumb-off"/>
                  </Border>
                </ToggleButton>
              </Grid>
            </Border>

            <Border Name="Do4Row" Classes="ch-row" Margin="0,0,0,0">
              <Grid ColumnDefinitions="Auto,*,Auto">
                <Ellipse Grid.Column="0" Name="Do4Dot" Classes="dot-off"/>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                  <TextBlock Classes="ch-name" Text="DO 4"/>
                  <TextBlock Classes="ch-addr" Text="Coil 3"/>
                </StackPanel>
                <ToggleButton Grid.Column="2"
                              Name="Do4Button"
                              Theme="{StaticResource SwitchToggleTheme}"
                              IsEnabled="{Binding IsConnected}"
                              VerticalAlignment="Center"
                              Click="Do4Button_Click">
                  <Border Name="Do4Track" Classes="track-off">
                    <Ellipse Name="Do4Thumb" Classes="thumb-off"/>
                  </Border>
                </ToggleButton>
              </Grid>
            </Border>

          </UniformGrid>
        </Grid>
      </Border>

      <Border Grid.Column="2" Classes="card">
        <Grid RowDefinitions="Auto,14,*">

          <Grid Grid.Row="0" ColumnDefinitions="*,Auto">
            <StackPanel Grid.Column="0">
              <TextBlock Classes="section-header" Text="Аналоговые входы"/>
              <TextBlock Classes="section-sub" Text="Holding Registers 0 – 15"/>
            </StackPanel>
            <Border Grid.Column="1" Background="#1c1c1c"
                    BorderBrush="#2a2a2a" BorderThickness="1"
                    CornerRadius="5" Padding="8,4" VerticalAlignment="Top">
              <TextBlock Text="Только чтение" Foreground="#444444"
                         FontSize="10" FontWeight="SemiBold"/>
            </Border>
          </Grid>

          <Rectangle Grid.Row="1" Height="1" Fill="#2a2a2a"/>

          <UniformGrid Grid.Row="2" Rows="4" Columns="1">

            <Border Classes="ch-row" Margin="0,0,0,6">
              <Grid ColumnDefinitions="Auto,*,Auto">
                <Border Grid.Column="0" Classes="ai-tag">
                  <TextBlock Text="AI" Foreground="#00e676"
                             FontSize="10" FontWeight="Bold"/>
                </Border>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                  <TextBlock Classes="ch-name" Text="AI 1"/>
                  <TextBlock Classes="ch-addr" Text="HR 0 – 3"/>
                </StackPanel>
                <TextBlock Grid.Column="2" Name="Ai1Value"
                           Classes="ai-reading" Text="{Binding AI1}"/>
              </Grid>
            </Border>

            <Border Classes="ch-row" Margin="0,0,0,6">
              <Grid ColumnDefinitions="Auto,*,Auto">
                <Border Grid.Column="0" Classes="ai-tag">
                  <TextBlock Text="AI" Foreground="#00e676"
                             FontSize="10" FontWeight="Bold"/>
                </Border>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                  <TextBlock Classes="ch-name" Text="AI 2"/>
                  <TextBlock Classes="ch-addr" Text="HR 4 – 7"/>
                </StackPanel>
                <TextBlock Grid.Column="2" Name="Ai2Value"
                           Classes="ai-reading" Text="{Binding AI2}"/>
              </Grid>
            </Border>

            <Border Classes="ch-row" Margin="0,0,0,6">
              <Grid ColumnDefinitions="Auto,*,Auto">
                <Border Grid.Column="0" Classes="ai-tag">
                  <TextBlock Text="AI" Foreground="#00e676"
                             FontSize="10" FontWeight="Bold"/>
                </Border>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                  <TextBlock Classes="ch-name" Text="AI 3"/>
                  <TextBlock Classes="ch-addr" Text="HR 8 – 11"/>
                </StackPanel>
                <TextBlock Grid.Column="2" Name="Ai3Value"
                           Classes="ai-reading" Text="{Binding AI3}"/>
              </Grid>
            </Border>

            <Border Classes="ch-row" Margin="0,0,0,0">
              <Grid ColumnDefinitions="Auto,*,Auto">
                <Border Grid.Column="0" Classes="ai-tag">
                  <TextBlock Text="AI" Foreground="#00e676"
                             FontSize="10" FontWeight="Bold"/>
                </Border>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                  <TextBlock Classes="ch-name" Text="AI 4"/>
                  <TextBlock Classes="ch-addr" Text="HR 12 – 15"/>
                </StackPanel>
                <TextBlock Grid.Column="2" Name="Ai4Value"
                           Classes="ai-reading" Text="{Binding AI4}"/>
              </Grid>
            </Border>

          </UniformGrid>
        </Grid>
      </Border>

    </Grid>
  </Grid>
</Window>